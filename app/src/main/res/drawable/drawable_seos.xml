        android:pathData="M12,8.5 m-2.2,0 a2.2,2.2 0 1 0 4.4,0 a2.2,2.2 0 1 0 -4.4,0"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"/>
    <path
        android:pathData="M11.1,10.6 L10.4,15.5 L13.6,15.5 L12.9,10.6 Z"
        android:fillColor="#FF000000"/>

</vector>
