    android:width="32dp"
    android:height="32dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- The common card silhouette: every technology shares it, the mark inside differs. -->
    <path
        android:pathData="M4,6 L20,6 A2,2 0 0 1 22,8 L22,16 A2,2 0 0 1 20,18 L4,18 A2,2 0 0 1 2,16 L2,8 A2,2 0 0 1 4,6 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.4"/>

    <!-- A keyhole: the credential lives in an ADF behind its own keys. -->
