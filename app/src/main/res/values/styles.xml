<resources>

    <!--
      Bridge themes: they inherit from the AppCompat themes this app has always used and
      only add the extra attributes Material Components needs (colorSurface and friends),
      which MaterialAlertDialogBuilder throws without. Widget styling is unchanged.
      -->
    <style name="App" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/secondaryColor</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="materialAlertDialogTheme">@style/App.AlertDialog</item>
    </style>

    <!--
      AppPreference.SettingActivity sets android:textColorPrimary to white so that the settings
      toolbar title is white. MaterialAlertDialogBuilder resolves its body text colour from the
      host activity's theme, which made dialog messages white on white. Pin the dialog's own
      text colours here instead of unpicking the toolbar hack.
      -->
    <style name="App.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:textColorPrimary">@color/primaryCardTextColor</item>
        <item name="android:textColorSecondary">@color/primaryCardTextColor</item>
    </style>

    <style name="AppPreference">
        <item name="android:layout">@layout/preference_material</item>
    </style>

    <style name="AppPreference.DialogPreference">
       <item name="android:textColor">@color/primaryColor</item>
    </style>

    <style name="AppPreference.SettingActivity"  parent="Theme.MaterialComponents.Light.Bridge">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#212121</item>
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/primaryDarkColor</item>
        <item name="colorControlNormal">@color/primaryDarkColor</item>
        <item name="colorControlActivated">@color/primaryColor</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="materialAlertDialogTheme">@style/App.AlertDialog</item>
    </style>

    <style name="App.WithTransitions"/>

    <style name="App.WithTransitions.LauncherActivity">
        <item name="android:windowBackground">@drawable/drawable_launch_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@color/ic_launcher_background</item>
    </style>

</resources>
